---
import { isFreeLook, lookNames } from "@tondo/page";
import { looks } from "@tondo/render";

interface Props {
    id: string;
    handle: string;
    name: string;
    role: string;
    look: string;
}

const { id, handle, name, role, look } = Astro.props;
const isPro = lookNames.some((key) => looks[key].label === look && !isFreeLook(key));
---

<a
    class="ex"
    aria-label={`${name}, ${role}`}
    href={`/${handle}`}
    data-preview={handle}
    data-name={name}
    data-role={role}
    data-shot={id}
>
    <figure style="margin:0">
        <div class="ex-phone">
            <img src={`/shots/${id}.jpg`} alt="" width="390" height="844" loading="lazy" />
        </div>
        <figcaption>
            <b>{name}</b>
            <span>
                {role.charAt(0).toUpperCase() + role.slice(1)}. {look} look.
                {isPro ? <small class="ex-pro">Pro</small> : null}
            </span>
        </figcaption>
    </figure>
</a>
