---
import PlanCards from "./PlanCards.astro";
import "../styles/plans.css";
---

<section class="band" id="pricing">
    <div class="wrap">
        <h2>Build for free, then try it live for 14 days</h2>
        <p class="sub">
            You can build and preview your page without paying. A plan is what puts it online at
            your address, and your first one starts with 14 free days.
        </p>
        <PlanCards />
        <a class="pl-more" href="/pricing">
            See everything in each plan
        </a>
    </div>
</section>
