---
import { cards } from "../data/plans";
import Art from "./Art.astro";
import "../styles/plans.css";
---

<div class="pc-row">
    <div class="pc-wash" aria-hidden="true">
        <Art seed={37} />
    </div>
    <div class="pc-cards">
        {cards.map((card) => (
            <article class="pc-card" data-plan-card={card.name}>
                <h3>
                    {card.name}
                    {card.recommended ? <small>Recommended</small> : null}
                </h3>
                <strong>{card.price}</strong>
                <p class="pc-period">{card.period}</p>
                <ul>
                    {card.features.map((feature) => (
                        <li>{feature}</li>
                    ))}
                </ul>
                {card.note ? <p class="pc-note">{card.note}</p> : null}
                <a class:list={["mbtn", { "pc-quiet": !card.recommended }]} href="/signup">
                    {card.cta}
                </a>
            </article>
        ))}
    </div>
</div>
