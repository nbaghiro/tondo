---
import "../styles/plans.css";
---

<section id="teams">
    <div class="wrap teamg">
        <div class="teamimg">
            <img src="/shots/june.jpg" alt="June Aster's page" loading="lazy" />
            <img src="/shots/aster.jpg" alt="Aster and Bell's page" loading="lazy" />
            <img src="/shots/rae.jpg" alt="Rae Bell's page" loading="lazy" />
        </div>
        <div>
            <h2>One look for the whole team</h2>
            <p class="sub">
                Everyone gets their own page, and the pages stay consistent. Change the team's look
                once and it reaches every page, and owners decide who can edit what.
            </p>
            <a class="pl-more" href="/teams">
                See more about teams
            </a>
        </div>
    </div>
</section>
