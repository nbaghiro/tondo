---
import Art from "./Art.astro";

interface Props {
    active: "analytics" | "team";
    team?: boolean;
}

const { active, team = false } = Astro.props;

// The app's own icons, drawn with its own strokes, so this reads as the real sidebar.
const icons: Record<string, string> = {
    home: '<path d="M4 11l8-7 8 7v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
    chart: '<path d="M4 19h16M7 16v-5M12 16V7M17 16v-8"/>',
    team: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20a6 6 0 0 1 12 0M16 5a3.5 3.5 0 0 1 0 6.5M18 14.5a6 6 0 0 1 3 5.5"/>',
    sliders:
        '<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>',
    help: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.6 2.2c-.7.4-1.1.9-1.1 1.8M12 17h.01"/>',
    person: '<circle cx="12" cy="8" r="4"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
};
const top = [
    { id: "home", icon: "home", label: "Home" },
    { id: "analytics", icon: "chart", label: "Analytics" },
    ...(team ? [{ id: "team", icon: "team", label: "Team" }] : []),
];
---

<div class="w-side" aria-hidden="true">
    <div class="w-logo">
        <span>
            <Art seed={9} />
        </span>
        Tondo
    </div>
    <div class="w-edit">Edit page</div>
    {top.map((item) => (
        <div class:list={["w-nav", { on: item.id === active }]}>
            <svg viewBox="0 0 24 24" set:html={icons[item.icon]} />
            {item.label}
        </div>
    ))}
    <small>Manage</small>
    <div class="w-nav">
        <svg viewBox="0 0 24 24" set:html={icons["sliders"]} />
        Page settings
    </div>
    <div class="w-foot">
        <div class="w-nav">
            <svg viewBox="0 0 24 24" set:html={icons["help"]} />
            Help
        </div>
        <div class="w-nav">
            <svg viewBox="0 0 24 24" set:html={icons["person"]} />
            Account
        </div>
    </div>
</div>
