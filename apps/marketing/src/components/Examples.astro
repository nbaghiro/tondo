---
import examples from "../data/examples.json";
import ExampleCard from "./ExampleCard.astro";
import PagePreview from "./PagePreview.astro";
---

<section id="pages" style="padding-top:60px">
    <div class="wrap ctr">
        <h2>Pages with room for what you do</h2>
        <p class="sub">
            Shops, studios, creators and clubs each get a page of their own. Open any of them for a
            closer look, or <a href="/gallery">see all {examples.length}</a>.
        </p>
    </div>
    <div class="ex-row" data-strip aria-label="Pages made with Tondo" role="group">
        <div class="ex-track">
            {examples.map((example) => (
                <ExampleCard
                    id={example.id}
                    handle={example.handle}
                    name={example.name}
                    role={example.role}
                    look={example.look}
                />
            ))}
        </div>
    </div>
    <PagePreview />
</section>

<script>
    const SPEED = 26;
    const HOVER_SPEED = 6;
    const EASE_MS = 450;
    const RESUME_MS = 1200;
    const DRAG_PX = 8;
    const COAST_MS = 320;

    const row = document.querySelector<HTMLElement>("[data-strip]");
    const track = row?.querySelector<HTMLElement>(".ex-track");
    if (row && track) {
        const originals = [...track.children];
        // A second copy lets the strip wrap with no visible jump. Keyboards and screen readers skip it.
        for (const card of originals) {
            const copy = card.cloneNode(true) as HTMLElement;
            copy.setAttribute("aria-hidden", "true");
            copy.tabIndex = -1;
            track.append(copy);
        }
        row.classList.add("is-moving");

        const still = matchMedia("(prefers-reduced-motion: reduce)");
        const setWidth = () => {
            const copy = track.children[originals.length];
            return copy instanceof HTMLElement ? copy.offsetLeft : track.scrollWidth / 2;
        };
        // Starts with the first page a little in from the left, and earlier pages filling the gap.
        let x = setWidth() - Math.min(170, Math.max(20, innerWidth * 0.085));
        let speed = still.matches ? 0 : SPEED;
        let hovering = false;
        let focused = false;
        let visible = true;
        let dragging = false;
        let last = 0;
        // Manual movement: where a person last touched the strip, and the speed they let go at.
        let touchedAt = -Infinity;
        let coast = 0;

        const draw = () => {
            track.style.transform = `translate3d(${-x}px, 0, 0)`;
        };
        const wrap = () => {
            const width = setWidth();
            x = ((x % width) + width) % width;
        };
        // Takes over from the automatic motion at once, and it eases back after a moment.
        const moveBy = (px: number) => {
            speed = 0;
            coast = 0;
            touchedAt = performance.now();
            x += px;
            wrap();
            draw();
        };
        const frame = (now: number) => {
            const ms = Math.min(now - last, 100);
            last = now;
            if (visible && !still.matches) {
                const busy = focused || dragging || now - touchedAt < RESUME_MS;
                const target = busy ? 0 : hovering ? HOVER_SPEED : SPEED;
                speed += (target - speed) * (1 - Math.exp(-ms / EASE_MS));
                coast *= Math.exp(-ms / COAST_MS);
                x += ((speed + coast) * ms) / 1000;
                wrap();
                draw();
            }
            requestAnimationFrame(frame);
        };
        draw();
        requestAnimationFrame((now) => {
            last = now;
            frame(now);
        });

        new IntersectionObserver((entries) => {
            visible = entries.some((entry) => entry.isIntersecting);
        }).observe(row);
        row.addEventListener("pointerover", (event) => {
            hovering =
                event.pointerType !== "touch" &&
                event.target instanceof Element &&
                event.target.closest(".ex") !== null;
        });
        row.addEventListener("pointerleave", () => {
            hovering = false;
        });

        // The strip stops while a card has keyboard focus, with that card in view.
        row.addEventListener("focusin", (event) => {
            const card = event.target;
            if (!(card instanceof HTMLElement) || !card.matches(":focus-visible")) return;
            focused = true;
            const left = card.offsetLeft - x;
            if (left < 20 || left + card.offsetWidth > row.clientWidth - 20) {
                x = card.offsetLeft - 40;
                wrap();
                draw();
            }
        });
        row.addEventListener("focusout", () => {
            focused = false;
        });

        // Touch keeps vertical page scrolling through touch-action: pan-y, so the browser cancels the
        // pointer if the gesture turns out to be a scroll, and only sideways movement reaches us.
        let pointer: number | null = null;
        let startX = 0;
        let lastX = 0;
        let lastAt = 0;
        let flick = 0;
        let dragged = false;
        row.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;
            pointer = event.pointerId;
            startX = lastX = event.clientX;
            lastAt = event.timeStamp;
            flick = 0;
            dragged = false;
        });
        row.addEventListener("pointermove", (event) => {
            if (event.pointerId !== pointer) return;
            if (!dragging) {
                if (Math.abs(event.clientX - startX) < DRAG_PX) return;
                dragging = dragged = true;
                row.classList.add("is-dragging");
                row.setPointerCapture(event.pointerId);
                lastX = event.clientX;
                lastAt = event.timeStamp;
            }
            const moved = lastX - event.clientX;
            const ms = event.timeStamp - lastAt;
            if (ms > 0) flick = (moved / ms) * 1000;
            lastX = event.clientX;
            lastAt = event.timeStamp;
            moveBy(moved);
        });
        const release = (event: PointerEvent) => {
            if (event.pointerId !== pointer) return;
            pointer = null;
            if (!dragging) return;
            dragging = false;
            row.classList.remove("is-dragging");
            touchedAt = performance.now();
            // A hand held still before letting go shouldn't send the strip anywhere.
            coast = !still.matches && event.timeStamp - lastAt < 80 ? flick : 0;
        };
        row.addEventListener("pointerup", release);
        row.addEventListener("pointercancel", release);
        // A drag ends with a click on the card under it, which must not open that page.
        row.addEventListener(
            "click",
            (event) => {
                if (!dragged) return;
                dragged = false;
                // Enter on a focused card is also a click, and has no pointer behind it.
                if (event.detail === 0) return;
                event.preventDefault();
                event.stopPropagation();
            },
            true,
        );
        row.addEventListener("dragstart", (event) => {
            event.preventDefault();
        });
        row.addEventListener(
            "wheel",
            (event) => {
                if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
                event.preventDefault();
                moveBy(event.deltaX);
            },
            { passive: false },
        );
    }
</script>
