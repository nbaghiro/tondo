---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Choose your address on Tondo">
    <h1>Choose your address</h1>
    <p class="auth-lead">This is the link you'll share. You can only have one for now.</p>
    <form data-auth="claim" novalidate>
        <label class="auth-field">
            Your address
            <span class="auth-address">
                tondo.page/
                <input
                    name="handle"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder="maya"
                    aria-label="Your address"
                    required
                />
            </span>
            <span class="auth-hint">Lowercase letters, numbers and hyphens.</span>
        </label>
        <p class="auth-error" role="alert" data-error></p>
        <button class="auth-submit" type="submit">
            Claim this address
        </button>
    </form>
</AuthLayout>

<script>
    import "../lib/auth-form";
</script>
