---
// Each example page opens at its own address, as a person's page would.
import type { GetStaticPaths } from "astro";

const files = import.meta.glob<string>("../data/pages/*.html", {
    query: "?raw",
    import: "default",
    eager: true,
});

export const getStaticPaths = (() =>
    Object.keys(import.meta.glob("../data/pages/*.html")).map((path) => ({
        params: { handle: path.replace(/^.*\/|\.html$/g, "") },
    }))) satisfies GetStaticPaths;

const html = files[`../data/pages/${Astro.params.handle}.html`] ?? "";
---

<Fragment set:html={html} />
