---
import { groups, heads } from "../data/plans";
import type { Cell } from "../data/plans";
import AppSide from "../components/AppSide.astro";
import Art from "../components/Art.astro";
import ClaimForm from "../components/ClaimForm.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import PlanCards from "../components/PlanCards.astro";
import LookTile from "../components/LookTile.astro";
import Nav from "../components/Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plans.css";

const said: Record<Exclude<Cell, object>, string> = {
    yes: "Included",
    no: "Not part of this plan",
};

const tiles = ["madder", "sumi", "sap", "dusk", "signal", "lilac"] as const;
const clicks = [
    ["Book a workshop", 86],
    ["Autumn sale", 62],
    ["New vases", 41],
    ["Instagram", 24],
] as const;

const faq = [
    {
        q: "What does it cost to try Tondo?",
        a: "Nothing. Building and previewing a page is free, and you don't need a card. You pay when you want the page online.",
    },
    {
        q: "What does the free plan include?",
        a: "Building and previewing one page, with every look, colour, font, background and kind of section, plus 25 photos and 15 Help me credits a month. Your address is held while you build. Putting the page online is what a paid plan adds.",
    },
    {
        q: "What's the difference between Starter and Pro?",
        a: "Starter has 1 live page, 100 Help me credits a month and 2,000 photos. Pro has 5 live pages, 300 credits and 2,000 photos, and includes team features at one price for the account. Design and sections are the same on both.",
    },
    {
        q: "What do visitors see before I publish?",
        a: "A short note saying there's no page at that address right now, with a link to log in. It doesn't show your name or anything from your draft.",
    },
    {
        q: "How do I cancel?",
        a: "From the Account page. Your page stays online until the period you paid for ends, and we refund your first payment if you ask within 14 days.",
    },
    {
        q: "What happens if a plan ends?",
        a: "Your page goes offline when the paid period ends. Visitors see the same short note, and your content stays. You can still log in and edit, and subscribing again puts the page back online. If a payment fails, the page stays up while the payment is retried, and goes offline only if the subscription ends.",
    },
];
---

<BaseLayout
    title="Pricing | Tondo"
    description="Tondo is free to build, and a paid plan puts your page online. Starter is $4 a month and Pro is $10 a month."
>
    <div class="wrap">
        <Nav />
        <header class="r-hero">
            <h1>Free to build, and paying puts it online</h1>
            <p class="sub">
                You can build and preview your page for free, with every look and kind of section. A
                plan is what puts it online at your address.
            </p>
            <PlanCards />
        </header>
    </div>

    <section class="band pl-sec r-today">
        <div class="wrap r-today-in">
            <div class="r-today-text">
                <h2>Every plan gets the whole editor</h2>
                <p class="sub">
                    Every look, colour, font, background and kind of section is on every plan, with
                    no limit on sections. Once a page is live, you can see how many people visited
                    and what they opened, over 7, 30 or 90 days.
                </p>
                <div class="r-tiles" aria-hidden="true">
                    {tiles.map((name) => (
                        <LookTile name={name} />
                    ))}
                </div>
            </div>
            <div class="r-desk">
                <div
                    class="win"
                    role="img"
                    aria-label="The Analytics screen in Tondo, with views and top links, drawn without figures"
                >
                    <AppSide active="analytics" />
                    <div class="win-main">
                        <div class="win-head">
                            <div>
                                <b>Analytics</b>
                                <small>How many people visit your page and what they open.</small>
                            </div>
                        </div>
                        <div class="win-seg">
                            <span class="on">7 days</span>
                            <span>30 days</span>
                            <span>90 days</span>
                        </div>
                        <svg class="win-chart" viewBox="0 0 400 110" preserveAspectRatio="none">
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20V110H0Z"
                                fill="#faf6f7"
                            />
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20"
                                fill="none"
                                stroke="#a42a55"
                                stroke-width="2.5"
                                vector-effect="non-scaling-stroke"
                            />
                        </svg>
                        <b class="win-label">Top links</b>
                        {clicks.map(([label, width]) => (
                            <div class="win-bar">
                                <span>{label}</span>
                                <i style={`width:${width}%`} />
                            </div>
                        ))}
                    </div>
                </div>
                <img
                    class="r-desk-phone"
                    src="/shots/noor.jpg"
                    alt=""
                    loading="lazy"
                    width="390"
                    height="844"
                />
            </div>
        </div>
    </section>

    <section class="pl-sec" id="compare">
        <div class="wrap">
            <div class="pl-head">
                <h2>Compare the plans</h2>
                <p class="sub">
                    Every plan has the whole editor. What changes is how many pages are online.
                </p>
            </div>
            <table class="r-table">
                <caption class="r-vh">Features of the Free, Starter and Pro plans</caption>
                <thead>
                    <tr>
                        <td></td>
                        {heads.map((head) => (
                            <th scope="col">
                                <b>{head.name}</b>
                                <span>{head.price}</span>
                            </th>
                        ))}
                    </tr>
                </thead>
                {groups.map((group) => (
                    <tbody>
                        <tr class="r-group">
                            <th scope="colgroup" colspan="4">
                                {group.name}
                            </th>
                        </tr>
                        {group.rows.map((row) => (
                            <tr>
                                <th scope="row">
                                    {row.label}
                                    {row.note ? <small>{row.note}</small> : null}
                                </th>
                                {row.cells.map((cell) => (
                                    <td>
                                        {typeof cell === "object" ? (
                                            <span class="r-value">{cell.value}</span>
                                        ) : (
                                            <>
                                                <i
                                                    class={cell === "yes" ? "r-yes" : "r-no"}
                                                    aria-hidden="true"
                                                />
                                                <span class="r-vh">{said[cell]}</span>
                                            </>
                                        )}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
            <p class="note r-tablenote">Prices are in US dollars, before any tax.</p>
        </div>
    </section>

    <Faq items={faq} />

    <section class="pl-cta">
        <div class="pl-cta-paint">
            <Art seed={66} />
        </div>
        <div class="wrap">
            <h2>Claim your link</h2>
            <p class="sub">It's free to build, and you won't need a card.</p>
            <ClaimForm id="claim-pricing" />
        </div>
    </section>
    <Footer />
</BaseLayout>
