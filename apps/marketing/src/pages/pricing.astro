---
import { PACK_PAGES, PLANS, PRICES } from "@tondo/page";
import { groups, heads } from "../data/plans";
import type { Cell } from "../data/plans";
import AppSide from "../components/AppSide.astro";
import Art from "../components/Art.astro";
import ClaimForm from "../components/ClaimForm.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import PlanCards from "../components/PlanCards.astro";
import LookTile from "../components/LookTile.astro";
import Nav from "../components/Nav.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plans.css";

const said: Record<Exclude<Cell, object>, string> = {
    yes: "Included",
    no: "Not part of this plan",
};

const tiles = ["madder", "sumi", "sap", "dusk", "signal", "lilac"] as const;
const clicks = [
    ["Book a workshop", 86],
    ["Autumn sale", 62],
    ["New vases", 41],
    ["Instagram", 24],
] as const;

const faq = [
    {
        q: "What is Tondo?",
        a: "Tondo gives you one address, such as tondo.page/maya, for a page of links, photos and details about you or your business, in a look you choose.",
    },
    {
        q: "How long does it take to set up?",
        a: "You make an account, type your name, choose sections and a look, and pick your address. Then you replace the sample content with your own and publish when it's ready.",
    },
    {
        q: "Can I try it before paying?",
        a: "Yes. Building and previewing a page costs nothing and needs no card. When you're ready to go online, your first subscription starts with 14 free days, and you add a card to start it.",
    },
    {
        q: "Why isn't there a free plan?",
        a: "Paying is what puts a page online. Building and previewing cost nothing, so you can see your whole page before you decide.",
    },
    {
        q: "What does it cost?",
        a: `Starter is $${String(PRICES.starter.month)} a month or $${String(PRICES.starter.year)} a year for 1 live page. Pro is $${String(PRICES.pro.month)} a month or $${String(PRICES.pro.year)} a year for ${String(PLANS.pro.live)} live pages. Prices are in US dollars, before any tax.`,
    },
    {
        q: "Can I have more than one page?",
        a: `Yes, on Pro. Each page has its own address and look, and you can add ${String(PACK_PAGES)} more pages for $${String(PRICES.pro.month)} a month, up to 100.`,
    },
    {
        q: "Can I use my own domain?",
        a: "Yes, on Pro. Your page shows at your domain instead of a tondo.page address.",
    },
    {
        q: "What can I add to my page?",
        a: "Links, photos, a shop, services and prices, bookings, events, video and music, questions, a team and tabs, among others. You can add as many sections as you need.",
    },
    {
        q: "Can I see how my page is doing?",
        a: "Yes. Analytics shows views and link clicks over 7, 30 or 90 days, and which links people opened.",
    },
    {
        q: "Can I switch from another link page?",
        a: "There's no automatic import. You can paste each link and Tondo adds it as a section, and Help me can read your website if you give it the address, and use what it finds to set up your page.",
    },
    {
        q: "Can I cancel at any time? What happens to my page?",
        a: "Yes, from your Account page. Your page goes offline when the period you've paid for ends, and your content stays. Subscribing again puts it back online.",
    },
    {
        q: "Does Tondo take a cut of my sales?",
        a: "No. Products on your page link out to wherever you already sell, so Tondo isn't part of the sale.",
    },
    {
        q: "Can I use Tondo with a team?",
        a: "Yes, on Pro.",
        link: { href: "/teams", text: "See how teams work." },
    },
];
---

<BaseLayout
    title="Pricing | Tondo"
    description="Building a page on Tondo is free, and a plan puts it online, starting with 14 free days. Starter is $5 a month and Pro is $12 a month."
>
    <div class="wrap">
        <Nav />
        <header class="r-hero">
            <h1>Build for free, then try it live for 14 days</h1>
            <p class="sub">
                You can build and preview your page without paying, with every look and kind of
                section. A plan is what puts it online at your address.
            </p>
            <PlanCards framed />
        </header>
    </div>

    <section class="band pl-sec r-today">
        <div class="wrap r-today-in">
            <div class="r-today-text">
                <h2>Both plans get the whole editor</h2>
                <p class="sub">
                    Every look, colour, font, background and kind of section is on both plans, with
                    no limit on sections. Once a page is live, you can see how many people visited
                    and what they opened, over 7, 30 or 90 days.
                </p>
                <div class="r-tiles" aria-hidden="true">
                    {tiles.map((name) => (
                        <LookTile name={name} />
                    ))}
                </div>
            </div>
            <div class="r-desk">
                <div
                    class="win"
                    role="img"
                    aria-label="The Analytics screen in Tondo, with views and top links, drawn without figures"
                >
                    <AppSide active="analytics" />
                    <div class="win-main">
                        <div class="win-head">
                            <div>
                                <b>Analytics</b>
                                <small>How many people visit your page and what they open.</small>
                            </div>
                        </div>
                        <div class="win-seg">
                            <span class="on">7 days</span>
                            <span>30 days</span>
                            <span>90 days</span>
                        </div>
                        <svg class="win-chart" viewBox="0 0 400 110" preserveAspectRatio="none">
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20V110H0Z"
                                fill="#faf6f7"
                            />
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20"
                                fill="none"
                                stroke="#a42a55"
                                stroke-width="2.5"
                                vector-effect="non-scaling-stroke"
                            />
                        </svg>
                        <b class="win-label">Top links</b>
                        {clicks.map(([label, width]) => (
                            <div class="win-bar">
                                <span>{label}</span>
                                <i style={`width:${width}%`} />
                            </div>
                        ))}
                    </div>
                </div>
                <img
                    class="r-desk-phone"
                    src="/shots/noor.jpg"
                    alt=""
                    loading="lazy"
                    width="390"
                    height="844"
                />
            </div>
        </div>
    </section>

    <section class="pl-sec" id="compare">
        <div class="wrap">
            <div class="pl-head">
                <h2>Compare the plans</h2>
                <p class="sub">
                    Both plans have the whole editor. Pro adds more pages and your own domain.
                </p>
            </div>
            <table class="r-table">
                <caption class="r-vh">Features of the Starter and Pro plans</caption>
                <thead>
                    <tr>
                        <td></td>
                        {heads.map((head) => (
                            <th scope="col">
                                <b>{head.name}</b>
                                <span>{head.price}</span>
                            </th>
                        ))}
                    </tr>
                </thead>
                {groups.map((group) => (
                    <tbody>
                        <tr class="r-group">
                            <th scope="colgroup" colspan="3">
                                {group.name}
                            </th>
                        </tr>
                        {group.rows.map((row) => (
                            <tr>
                                <th scope="row">
                                    {row.label}
                                    {row.note ? <small>{row.note}</small> : null}
                                </th>
                                {row.cells.map((cell) => (
                                    <td>
                                        {typeof cell === "object" ? (
                                            <span class="r-value">{cell.value}</span>
                                        ) : (
                                            <>
                                                <i
                                                    class={cell === "yes" ? "r-yes" : "r-no"}
                                                    aria-hidden="true"
                                                />
                                                <span class="r-vh">{said[cell]}</span>
                                            </>
                                        )}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
            <p class="note r-tablenote">Prices are in US dollars, before any tax.</p>
        </div>
    </section>

    <Faq items={faq} band />

    <section class="pl-cta">
        <div class="pl-cta-paint">
            <Art seed={66} />
        </div>
        <div class="wrap">
            <h2>Claim your link</h2>
            <p class="sub">It's free to build, and you won't need a card until you go online.</p>
            <ClaimForm id="claim-pricing" />
        </div>
    </section>
    <Footer />
</BaseLayout>
