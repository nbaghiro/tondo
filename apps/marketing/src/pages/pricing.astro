---
import { paint } from "@tondo/render";
import { groups, heads } from "../data/plans";
import type { Cell } from "../data/plans";
import AppSide from "../components/AppSide.astro";
import Art from "../components/Art.astro";
import ClaimForm from "../components/ClaimForm.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import LookTile from "../components/LookTile.astro";
import Nav from "../components/Nav.astro";
import Status from "../components/Status.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/plans.css";

const said: Record<Exclude<Cell, object>, string> = {
    yes: "Works today",
    coming: "Coming",
    no: "Not part of this plan",
};
const saidPaid = { ...said, yes: "Works today, and will be part of this plan" };

const tiles = ["madder", "sumi", "sap", "dusk", "signal", "lilac"] as const;
const clicks = [
    ["Book a workshop", 86],
    ["Autumn sale", 62],
    ["New vases", 41],
    ["Instagram", 24],
] as const;

const faq = [
    {
        q: "What does Tondo cost today?",
        a: "Nothing. Paid plans can't be bought yet, so every account can use everything that works today, and we don't ask for a card.",
    },
    {
        q: "What will the free plan include?",
        a: "One page at your own address, 12 looks with their own colours and fonts, 14 kinds of section with up to 6 on a page, 25 photos and 7 days of statistics. Free pages will carry a small Made with Tondo.",
    },
    {
        q: "Can I try Pro before paying?",
        a: "That's the plan. Anything in Pro will work in the editor, marked with a small label, and you'll only be asked when you publish. You'll also be able to publish with free choices instead, and your draft keeps everything.",
    },
    {
        q: "How do I cancel?",
        a: "There's nothing to cancel today, because nobody is paying. You can delete your account at any time from the Account page, which removes your page. When paid plans open, you'll be able to cancel from the same page, and we plan to refund your first payment if you ask within 14 days.",
    },
    {
        q: "What happens if a plan ends?",
        a: "Your page stays online at its address and your content stays. The Tondo mark returns and the free limits apply. After 30 days, paid looks, your own colours and fonts and photo backgrounds change to free ones on your live page. Your draft keeps them, so they come back if you subscribe again.",
    },
    {
        q: "Which plan will each coming feature be on?",
        a: "The table shows our current thinking for anything marked Coming, and a feature might land on a different plan from the one shown here.",
    },
    {
        q: "When will Pro and Team be available?",
        a: "We don't have a date. Paid plans come after a private release, and Team comes after that. To hear about teams, email hello@tondo.page.",
    },
];
---

<BaseLayout
    title="Pricing | Tondo"
    description="Tondo's Free, Pro and Team plans. Paid plans can't be bought yet, so everything that works today is free for now."
>
    <div class="wrap logo-wide">
        <Nav />
        <header class="r-hero">
            <h1>Free for now, with paid plans on the way</h1>
            <p class="sub">
                Paid plans can't be bought yet, so every account can use everything that works
                today. This page shows how Free and Pro will work once they open.
            </p>
            <div class="r-discs">
                <div class="r-plan">
                    <div class="r-art">
                        <div class="r-disc r-disc-free">
                            <Art seed={3} />
                            <img
                                src="/shots/maya.jpg"
                                alt="Maya Okafor's example page"
                                width="390"
                                height="844"
                            />
                        </div>
                    </div>
                    <h2>Free</h2>
                    <strong>$0</strong>
                    <Status now label="Available today" />
                    <p>One page, 12 looks, up to 6 sections and 7 days of statistics.</p>
                    <a class="mbtn" href="/signup">
                        Get started
                    </a>
                </div>
                <div class="r-plan">
                    <div class="r-art">
                        <div class="r-disc" set:html={paint(["#a42a55"], 37, { ring: 6 })} />
                        <div class="r-inside" aria-hidden="true">
                            <span class="r-domain">yourname.com</span>
                        </div>
                    </div>
                    <h2>Pro</h2>
                    <strong>$6 a month</strong>
                    <Status label="Planned" />
                    <p>All 50 looks, your own colour and fonts, Shop, Tabs and no Tondo mark.</p>
                </div>
                <div class="r-plan">
                    <div class="r-art">
                        <div class="r-disc" set:html={paint(["#a42a55"], 41, { ring: 6 })} />
                        <div class="r-inside r-faces" aria-hidden="true">
                            <img src="/photos/face-24.jpg" alt="" />
                            <img src="/photos/face-25.jpg" alt="" />
                            <img src="/photos/face-29.jpg" alt="" />
                        </div>
                    </div>
                    <h2>Team</h2>
                    <strong>$4 a person</strong>
                    <Status label="Planned" />
                    <p>A page for each person, shared looks and roles.</p>
                    <a class="pl-link" href="/teams">
                        About teams
                    </a>
                </div>
            </div>
        </header>
    </div>

    <section class="band pl-sec r-today">
        <div class="wrap logo-wide r-today-in">
            <div class="r-today-text">
                <Status now />
                <h2>What Free will include</h2>
                <p class="sub">
                    One address and one page, built in the full editor. Choose from 12 looks, add up
                    to 6 sections and see how many people visited in the last 7 days and what they
                    opened.
                </p>
                <div class="r-tiles" aria-hidden="true">
                    {tiles.map((name) => (
                        <LookTile name={name} />
                    ))}
                </div>
            </div>
            <div class="r-desk">
                <div
                    class="win"
                    role="img"
                    aria-label="The Analytics screen in Tondo, with views and top links, drawn without figures"
                >
                    <AppSide active="analytics" />
                    <div class="win-main">
                        <div class="win-head">
                            <div>
                                <b>Analytics</b>
                                <small>How many people visit your page and what they open.</small>
                            </div>
                        </div>
                        <div class="win-seg">
                            <span class="on">7 days</span>
                            <span>30 days</span>
                            <span>90 days</span>
                        </div>
                        <svg class="win-chart" viewBox="0 0 400 110" preserveAspectRatio="none">
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20V110H0Z"
                                fill="#faf6f7"
                            />
                            <path
                                d="M0 92C40 88 60 70 95 74S150 50 190 58 250 26 290 36 360 16 400 20"
                                fill="none"
                                stroke="#a42a55"
                                stroke-width="2.5"
                                vector-effect="non-scaling-stroke"
                            />
                        </svg>
                        <b class="win-label">Top links</b>
                        {clicks.map(([label, width]) => (
                            <div class="win-bar">
                                <span>{label}</span>
                                <i style={`width:${width}%`} />
                            </div>
                        ))}
                    </div>
                </div>
                <img
                    class="r-desk-phone"
                    src="/shots/noor.jpg"
                    alt=""
                    loading="lazy"
                    width="390"
                    height="844"
                />
            </div>
        </div>
    </section>

    <section class="pl-sec" id="compare">
        <div class="wrap logo-wide">
            <div class="pl-head">
                <h2>Compare the plans</h2>
                <p class="sub">
                    Until paid plans open, every account can use everything that works today,
                    including what's marked for Pro.
                </p>
            </div>
            <ul class="r-legend">
                <li>
                    <i class="r-yes" aria-hidden="true"></i> Works today
                </li>
                <li>
                    <span class="st">Coming</span> Planned and not built yet
                </li>
                <li>
                    <i class="r-no" aria-hidden="true"></i> Not part of this plan
                </li>
            </ul>
            <table class="r-table">
                <caption class="r-vh">
                    Features of the Free plan and the planned Pro and Team plans
                </caption>
                <thead>
                    <tr>
                        <td></td>
                        {heads.map((head) => (
                            <th scope="col">
                                <b>{head.name}</b>
                                <span>{head.price}</span>
                                <small>{head.note}</small>
                            </th>
                        ))}
                    </tr>
                </thead>
                {groups.map((group) => (
                    <tbody>
                        <tr class="r-group">
                            <th scope="colgroup" colspan="4">
                                {group.name}
                            </th>
                        </tr>
                        {group.rows.map((row) => (
                            <tr>
                                <th scope="row">
                                    {row.label}
                                    {row.note ? <small>{row.note}</small> : null}
                                </th>
                                {row.cells.map((cell, i) => (
                                    <td>
                                        {typeof cell === "object" ? (
                                            <>
                                                <span class="r-value">{cell.value}</span>
                                                {cell.coming ? (
                                                    <span class="st">Coming</span>
                                                ) : null}
                                            </>
                                        ) : cell === "coming" ? (
                                            <span class="st">Coming</span>
                                        ) : (
                                            <>
                                                <i
                                                    class:list={[
                                                        cell === "yes" ? "r-yes" : "r-no",
                                                        { "r-later": i > 0 },
                                                    ]}
                                                    aria-hidden="true"
                                                />
                                                <span class="r-vh">
                                                    {(i === 0 ? said : saidPaid)[cell]}
                                                </span>
                                            </>
                                        )}
                                    </td>
                                ))}
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
            <p class="note r-tablenote">
                Prices are in US dollars, before any tax, and could still change before paid plans
                open. A tick under Pro or Team means the feature works today and will be part of
                that plan.
            </p>
        </div>
    </section>

    <Faq items={faq} />

    <section class="pl-cta">
        <div class="pl-cta-paint">
            <Art seed={66} />
        </div>
        <div class="wrap logo-wide">
            <h2>Claim your link</h2>
            <p class="sub">It's free today, and you won't need a card.</p>
            <ClaimForm id="claim-pricing" />
        </div>
    </section>
    <Footer />
</BaseLayout>
