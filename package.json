{
    "name": "tondo",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "dev": "turbo run dev",
        "build": "turbo run build",
        "start": "pnpm --filter @tondo/server start",
        "services:up": "docker compose up -d --wait",
        "services:down": "docker compose down",
        "db:generate": "pnpm --filter @tondo/db generate",
        "db:migrate": "pnpm --filter @tondo/db migrate",
        "db:seed": "pnpm --filter @tondo/db seed",
        "db:studio": "pnpm --filter @tondo/db studio",
        "db:reset": "docker compose down -v && pnpm services:up && pnpm db:migrate && pnpm db:seed",
        "db:psql": "docker compose exec postgres psql -U tondo -d tondo",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit && turbo run typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "e2e": "playwright test",
        "check:boundaries": "tsx scripts/check-boundaries.ts",
        "check:suppressions": "tsx scripts/check-suppressions.ts",
        "check:ports": "tsx scripts/check-ports.ts",
        "scratchpad": "tsx scripts/serve-scratchpad.ts",
        "ports:audit": "tsx scripts/audit-ports.ts",
        "check": "pnpm format:check && pnpm check:suppressions && pnpm check:boundaries && pnpm check:ports && pnpm check:naming && pnpm lint && pnpm typecheck && pnpm test",
        "check:naming": "tsx scripts/check-naming.ts"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.0",
        "@types/node": "catalog:",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-solid": "^0.18.1",
        "postgres": "^3.4.9",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "tsx": "catalog:",
        "turbo": "^2.11.10",
        "typescript": "catalog:",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
