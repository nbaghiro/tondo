# Local defaults. The apps fall back to these values, so a .env file is only needed to change them.
DATABASE_URL=postgres://tondo:tondo@127.0.0.1:8102/tondo
PORT=8101

# Sign-in, from Neon Auth. Without these the site runs, and sign-in says it isn't set up.
# NEON_AUTH_BASE_URL is the Auth URL in the Neon console. For the secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Photo uploads, over the S3 API. Locally these default to RustFS from docker-compose.yml, so they're
# only needed in production, where they point at Cloudflare R2.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=tondo-photos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto

# Where people land after signing in. Open the apps at localhost so they share the cookie.
SITE_URL=http://localhost:8103
EDITOR_URL=http://localhost:8100

# How many proxies of ours sit in front of the server. Rate limits only believe that many
# forwarded addresses. 0 uses the connection's own address, which is right for local work.
TRUSTED_PROXY_HOPS=0

# Help me, on Gemini. Without a key its button stays hidden. Use a paid-tier key: Google can use
# content sent on the free tier to improve its products.
GOOGLE_API_KEY=
# ASSISTANT_MODEL=gemini-3.5-flash-lite
# ASSISTANT_DAILY_USD=20

# Stock photos in Help me. Without this it searches Openverse only.
PEXELS_API_KEY=

# Plans. While this is false everyone behaves as paid, Help me credits stay at the unsubscribed number and nothing
# mentions plans. Keep it off everywhere except tests until the Stripe setup is done.
PLANS_ON=false
# Stripe, needed when PLANS_ON is true. The server won't start unless the Prices starter_month,
# starter_year, pro_month and pro_year exist at $5, $48, $12 and $120. Pro's quantity is how many packs of 5 pages, so those Prices must allow it. Use a restricted key, and never commit
# it. Turn STRIPE_TAX on only once a tax registration in Stripe shows as collecting.
# STRIPE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TAX=false

# Customer domains, off until all three are set. On Render only the key is needed, because Render
# sets the other two itself. APP_HOSTS adds names that reach the whole site, comma-separated.
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_EXTERNAL_HOSTNAME=
# APP_HOSTS=
