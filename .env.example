# Local defaults. The apps fall back to these values, so a .env file is only needed to change them.
DATABASE_URL=postgres://tondo:tondo@127.0.0.1:8102/tondo
PORT=8101

# Sign-in, from Neon Auth. Without these the site runs, and sign-in says it isn't set up.
# NEON_AUTH_BASE_URL is the Auth URL in the Neon console. For the secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Where people land after signing in. Open the apps at localhost so they share the cookie.
SITE_URL=http://localhost:8103
EDITOR_URL=http://localhost:8100
