        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tondo/page": "workspace:*",
        "drizzle-orm": "catalog:",
        "postgres": "^3.4.7"
    },
    "devDependencies": {
        "drizzle-kit": "^0.31.11",
        "tsx": "catalog:"
    }
}
